# ── Auth0 tenant ──────────────────────────────────────────────────────────────
# Your Auth0 domain (no https://, no trailing slash)
AUTH0_DOMAIN=your-tenant.auth0.com

# ── Auth0 Application (Single Page or Regular Web App) ────────────────────────
# In Auth0 dashboard: Applications → Applications → Create Application
# Add http://127.0.0.1:8002/auth/callback to "Allowed Callback URLs"
AUTH0_CLIENT_ID=your-client-id
AUTH0_CLIENT_SECRET=your-client-secret

# ── Auth0 API (Resource Server) ───────────────────────────────────────────────
# Applications → APIs → Create API
# Set the identifier to something like: https://api.payment-agent-v2
AUTH0_AUDIENCE=https://api.payment-agent-v2

# ── Server ────────────────────────────────────────────────────────────────────
SERVER_2_PORT=8002
