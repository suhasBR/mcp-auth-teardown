# ── Auth0 tenant ──────────────────────────────────────────────────────────────
AUTH0_DOMAIN=your-tenant.auth0.com

# ── Auth0 API (Resource Server) ───────────────────────────────────────────────
# Create in Auth0: Applications → APIs → Create API
# Set identifier to EXACTLY: http://127.0.0.1:8003/mcp
# This becomes the `aud` claim FastMCP validates on every request.
AUTH0_AUDIENCE_V3=http://127.0.0.1:8003/mcp

# ── Downstream API (optional — only needed for RFC 8693 token exchange demo) ──
# The audience of the downstream service the MCP server calls on behalf of users.
# Leave blank to skip the token exchange step (server still runs fine).
DOWNSTREAM_AUDIENCE=

# ── Server ────────────────────────────────────────────────────────────────────
SERVER_3_PORT=8003
