# Captured OAuth tokens for the attack demo.
# DO NOT commit tokens.env — it is gitignored.
#
# Run `make capture-tokens` to populate tokens.env automatically.
# Tokens expire (Server #2 tokens: 1h, Server #3 Auth0 tokens: 24h).
# Re-run `make capture-tokens` if attacks fail with 401.

# FastMCP JWT issued by Server #2 (aud=http://127.0.0.1:8002/mcp)
# Used by: attacks/02_token_replay.py, attacks/03_cross_server_token.py
SERVER_2_FASTMCP_TOKEN=

# Auth0 JWT issued for Server #3 via PKCE (aud=http://127.0.0.1:8003/mcp)
# sub claim = alice's Auth0 user ID
# Used by: attacks/03_cross_server_token.py (comparison), attacks/04_confused_deputy.py
ALICE_AUTH0_TOKEN=
