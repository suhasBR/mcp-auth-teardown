# Root .env.example — copy to .env and fill in values.
# Server #1 works with just the MCP_API_KEY below.
# Server #2 and #3 need the Auth0 sections (you fill those in).

# =============================================================
# Server #1 — Static API Key (no Auth0 needed)
# =============================================================
MCP_API_KEY=sk-apikey-demo-1234-definitely-not-a-secret
SERVER_1_PORT=8001

# =============================================================
# Server #2 — FastMCP Auth Proxy (Auth0 M2M)
# =============================================================
SERVER_2_PORT=8002

# Your Auth0 tenant domain, e.g. dev-abc123.us.auth0.com
AUTH0_DOMAIN=

# M2M application credentials for the proxy server
AUTH0_CLIENT_ID_PROXY=
AUTH0_CLIENT_SECRET_PROXY=

# The API identifier you register in Auth0 for server-2
AUTH0_AUDIENCE_V2=api://payment-agent-v2

# =============================================================
# Server #3 — Resource Server (Auth0 PKCE + Token Exchange)
# =============================================================
SERVER_3_PORT=8003

# The API identifier for server-3 (must differ from v2 for audience validation)
AUTH0_AUDIENCE_V3=api://payment-agent-v3

# PKCE client (no client secret — public client)
AUTH0_CLIENT_ID_PKCE=

# Auth0 Management API credentials (for provisioning script only)
AUTH0_MGMT_CLIENT_ID=
AUTH0_MGMT_CLIENT_SECRET=
